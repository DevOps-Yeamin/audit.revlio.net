# ==========================================
# REVLIO FREE WEBSITE AUDIT (audit.revlio.net)
# Environment Configuration
# ==========================================

# Database Connection (PostgreSQL or SQLite)
# For SQLite (default local dev): sqlite+aiosqlite:///./revlio_audit.db
# For PostgreSQL (production VPS): postgresql+asyncpg://revlio_user:password@localhost:5432/revlio_audit
DATABASE_URL=sqlite+aiosqlite:///./revlio_audit.db

# Google PageSpeed Insights API Key (Optional, enhances Core Web Vitals)
# Get a free key at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Zoho Campaigns API Credentials (Direct Lead Sync & hello@revlio.net replies)
# Generated from Zoho API Console: https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_LIST_KEY=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://campaigns.zoho.com
ZOHO_REPLY_TO_EMAIL=hello@revlio.net

# Revlio Contact & Consultation Links
REVLIO_SALES_EMAIL=hello@revlio.net
REVLIO_BOOK_URL=https://revlio.net/contact
